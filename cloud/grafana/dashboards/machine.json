            "uid": "timescale"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT value_text FROM telemetry WHERE machine_id = '$machine' AND metric = 'mode' ORDER BY ts DESC LIMIT 1"
        }
      ],
      "fieldConfig": {
