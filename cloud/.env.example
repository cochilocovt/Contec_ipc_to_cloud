# Copy to .env (git-ignored) and change every value.
DB_PASSWORD=change-me-db
GRAFANA_DB_PASSWORD=change-me-grafana-reader
GRAFANA_ADMIN_PASSWORD=change-me-admin
# Set to this PC's home-LAN IPv4 address to accept gateway connections.
# Loopback is the safe default; never use 0.0.0.0 for the open home-lab broker.
MQTT_BIND_ADDRESS=127.0.0.1
# Use another unused port, e.g. 5433, if a local PostgreSQL already owns 5432.
DB_HOST_PORT=5432
